# This is a reference only; the app reads process environment variables, not this file.
APP_MODE=demo
DEMO_SEED=true
DEMO_DATA_DIR=.local-data
# Production requires all four settings below. Inject the OAuth JSON using Secret Manager.
# GOOGLE_FOLDER_ID=
# GOOGLE_TOKEN_JSON=
# IAP_AUDIENCE=/projects/PROJECT_NUMBER/locations/REGION/services/salestrackr
# PUBLIC_ORIGIN=https://YOUR_SERVICE_URL
# Local ProductTrackr uses an isolated emulator; backups remain local.
# PRODUCTTRACKR_ENABLED=true
# PRODUCTTRACKR_FIRESTORE_PROJECT_ID=demo-producttrackr-local
# PRODUCTTRACKR_WORKSPACE_ID=producttrackr
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Products, Backups and the directory workbook share GOOGLE_FOLDER_ID and GOOGLE_TOKEN_JSON.
# PRODUCTTRACKR_BACKUP_STORAGE=local
# Production-only settings (the deployment workflow supplies these).
# PRODUCTTRACKR_FIRESTORE_PROJECT_ID=YOUR_EXISTING_CLOUD_PROJECT
# PRODUCTTRACKR_FIRESTORE_DATABASE_ID=(default)
# PRODUCTTRACKR_BACKUP_STORAGE=drive
# PRODUCTTRACKR_ADMIN_EMAILS=ADMIN_EMAIL
# Both Trackrs always share Settings and recovery. Their workspace IDs stay distinct.
# STORAGE_BACKEND=firestore
# FIRESTORE_PROJECT_ID=demo-producttrackr-local
# PRODUCTTRACKR_FIRESTORE_PROJECT_ID=demo-producttrackr-local
# ProductTrackr requires the same Firestore project/database as SalesTrackr.
# BACKUP_DRIVE_FOLDER_ID remains the dedicated Backups folder inside that SalesTrackr root.
# Migrate existing Drive items before deployment; remove old authorization only after verification.
